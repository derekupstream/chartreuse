// ChartReuse Prisma schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id
  name                String?
  email               String        @unique
  title               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  phone               String?
  role                Role          @default(ORG_ADMIN)
  orgId               String        @db.Uuid
  accountId           String?       @db.Uuid
  invitesSent         Invite[]
  joinRequestsDecided JoinRequest[]
  account             Account?      @relation(fields: [accountId], references: [id])
  org                 Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model UserEvent {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  userId    String
  type      String
}

model Org {
  name                 String
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  id                   String            @id @default(uuid()) @db.Uuid
  isUpstream           Boolean           @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currency             String            @default("USD")
  useMetricSystem      Boolean           @default(false)
  useShrinkageRate     Boolean           @default(false)
  orgInviteCode        String?           @unique
  orgType              String?
  country              String?
  city                 String?
  employeeCount        String?
  locationCount        String?
  reuseJourneyStage    String?
  primaryChallenge     String?
  analyticsSlug        String?           @unique
  // Curated product catalog: { reusableProductIds?: string[], singleUseProductIds?: string[] }.
  // Null/empty lists = full catalog. Filters the product pickers via /api/inventory/*.
  catalogSettings      Json?
  accounts             Account[]
  rspClientAccounts    Account[]         @relation("AccountRspOrg")
  invites              Invite[]
  projects             Project[]
  projectTags          ProjectTag[]
  rspApiKeys           RspApiKey[]
  usagePeriods         UsageTimePeriod[]
  users                User[]
  computeRuns          ComputeRun[]
  joinRequests         JoinRequest[]
}

model Account {
  name                String
  metadata            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  accountContactEmail String
  id                  String            @id @default(uuid()) @db.Uuid
  orgId               String            @db.Uuid
  USState             String            @default("California")
  rspClientId         String?
  rspOrgId            String?           @db.Uuid
  venueCategory       String? // venue type — see lib/calculator/constants/venue-categories.ts
  org                 Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rspOrg              Org?              @relation("AccountRspOrg", fields: [rspOrgId], references: [id])
  invites             Invite[]
  projects            Project[]
  usagePeriods        UsageTimePeriod[]
  users               User[]
}

model Invite {
  email        String
  accepted     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sentByUserId String
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String?  @db.Uuid
  orgId        String   @db.Uuid
  account      Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sentBy       User     @relation(fields: [sentByUserId], references: [id], onDelete: Cascade)
}

model Project {
  name                         String
  metadata                     Json?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  id                           String                    @id @default(uuid()) @db.Uuid
  orgId                        String                    @db.Uuid
  accountId                    String                    @db.Uuid
  USState                      String?
  utilityRates                 Json?
  currency                     String?                   @default("USD")
  budget                       Int?
  singleUseReductionPercentage Int?
  isTemplate                   Boolean                   @default(false)
  templateDescription          String?
  templateId                   String?                   @db.Uuid
  category                     ProjectCategory           @default(default)
  dataType                     ProjectDataType           @default(projection)
  eventGuestCount              Int                       @default(0)
  projectionsDescription       String?
  projectionsTitle             String?
  publicSlug                   String?                   @unique
  shareSettings                Json?
  recommendations              Json?
  showRecommendations          Boolean                   @default(true)
  location                     Json?
  dateType                     String?
  endDate                      DateTime?                 @db.Date
  startDate                    DateTime?                 @db.Date
  dishwashers                  Dishwasher[]
  dishwashersSimple            DishwasherSimple[]
  eventFoodwareItems           EventFoodwareLineItem[]
  laborCosts                   LaborCost[]
  otherExpenses                OtherExpense[]
  account                      Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  org                          Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template                     Project?                  @relation("templates", fields: [templateId], references: [id])
  projects                     Project[]                 @relation("templates")
  tags                         ProjectTagRelation[]
  reusableItems                ReusableLineItem[]
  singleUseItems               SingleUseLineItem[]
  truckTransportationCosts     TruckTransportationCost[]
  wasteHaulingCosts            WasteHaulingCost[]
  milestones                   ProjectMilestone[]
  computeRuns                  ComputeRun[]
}

model ProjectMilestone {
  id                 String      @id @default(uuid()) @db.Uuid
  createdAt          DateTime    @default(now())
  projectId          String      @db.Uuid
  snapshotDate       DateTime    @db.Date
  label              String?
  source             String      @default("manual")
  co2AvoidedMtco2e   Float?
  waterSavedGallons  Float?
  wasteDivertedLbs   Float?
  annualCostSavings  Float?
  paybackMonths      Int?
  annualROIPct       Float?
  envBreakEvenMonths Float?
  returnRatePct      Float?
  rawMetrics         Json?
  computeRunId       String?     @db.Uuid
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  computeRun         ComputeRun? @relation(fields: [computeRunId], references: [id])
}

model EventFoodwareLineItem {
  id                       String   @id @default(uuid()) @db.Uuid
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  singleUseProductId       String
  reusableProductId        String
  reusableItemCount        Int      @default(0)
  reusableReturnPercentage Float    @default(100)
  projectId                String   @db.Uuid
  waterUsageGallons        Float?
  reusableReturnCount      Int      @default(0)
  reusableCostPerItem      Float?
  singleUseCostPerItem     Float?
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SingleUseLineItem {
  caseCost          Float
  casesPurchased    Int
  frequency         String
  productId         String
  newCaseCost       Float
  newCasesPurchased Int
  unitsPerCase      Int
  id                String                    @id @default(uuid()) @db.Uuid
  projectId         String                    @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now()) @updatedAt
  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records           SingleUseLineItemRecord[]
}

model SingleUseLineItemRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  createdAt           DateTime          @default(now())
  entryDate           DateTime
  caseCost            Float
  casesPurchased      Int
  unitsPerCase        Int
  singleUseLineItemId String            @db.Uuid
  singleUseLineItem   SingleUseLineItem @relation(fields: [singleUseLineItemId], references: [id], onDelete: Cascade)

  @@unique([singleUseLineItemId, entryDate])
}

model ReusableLineItem {
  annualRepurchasePercentage Float
  caseCost                   Float
  casesPurchased             Int
  categoryId                 String?
  productName                String?
  id                         String   @id @default(uuid()) @db.Uuid
  projectId                  String   @db.Uuid
  unitsPerCase               Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now()) @updatedAt
  productId                  String?
  project                    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OtherExpense {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String
  cost        Float
  description String
  frequency   String
  projectId   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LaborCost {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String
  cost        Float
  description String
  frequency   String
  projectId   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WasteHaulingCost {
  id             String   @id @default(uuid()) @db.Uuid
  monthlyCost    Float
  wasteStream    String
  serviceType    String
  projectId      String   @db.Uuid
  newMonthlyCost Float
  description    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TruckTransportationCost {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  distanceInMiles Float
  projectId       String   @db.Uuid
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Dishwasher {
  id                          String   @id @default(uuid()) @db.Uuid
  boosterWaterHeaterFuelType  String?
  buildingWaterHeaterFuelType String
  energyStarCertified         Boolean
  operatingDays               Int
  temperature                 String
  type                        String
  projectId                   String   @db.Uuid
  newOperatingDays            Int
  newRacksPerDay              Int
  racksPerDay                 Int
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @default(now()) @updatedAt
  project                     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DishwasherSimple {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  electricUsage Float
  waterUsage    Float
  fuelType      String
  projectId     String   @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectTag {
  id       String               @id @default(uuid()) @db.Uuid
  label    String
  index    Int
  orgId    String               @db.Uuid
  org      Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects ProjectTagRelation[]
}

model ProjectTagRelation {
  projectId String     @db.Uuid
  tagId     String     @db.Uuid
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model MethodologyDocument {
  id            String    @id @default(uuid()) @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  title         String
  slug          String    @unique
  content       Json
  status        String    @default("draft")
  publishedAt   DateTime?
  order         Int       @default(0)
  sectionNumber String    @default("")
}

model ImpersonationSession {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String
  targetUserId String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model FeedbackSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  userId    String
  category  String
  message   String
  pageUrl   String?
  status    String   @default("open")
}

model GoldenDataset {
  id              String          @id @default(uuid()) @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  name            String
  description     String?
  category        String          @default("default")
  inputs          Json
  expectedOutputs Json
  tolerance       Float           @default(0.02)
  isActive        Boolean         @default(true)
  sourceProjectId String?         @db.Uuid
  tags            String[]        @default([])
  testResults     TestRunResult[]
}

model TestRun {
  id                    String               @id @default(uuid()) @db.Uuid
  createdAt             DateTime             @default(now())
  ranByUserId           String
  status                String               @default("running")
  totalTests            Int                  @default(0)
  passed                Int                  @default(0)
  failed                Int                  @default(0)
  methodologySnapshotId String?              @db.Uuid
  results               TestRunResult[]
  methodologySnapshot   MethodologySnapshot? @relation(fields: [methodologySnapshotId], references: [id])
}

model TestRunResult {
  id            String        @id @default(uuid()) @db.Uuid
  testRunId     String        @db.Uuid
  datasetId     String        @db.Uuid
  passed        Boolean
  actualOutputs Json?
  diff          Json?
  errorMessage  String?
  dataset       GoldenDataset @relation(fields: [datasetId], references: [id])
  testRun       TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)
}

model FactorCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  factors     Factor[]
}

model FactorSource {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  version     String
  url         String?
  lastChecked DateTime @default(now())
  isActive    Boolean  @default(true)
  factors     Factor[]
}

model Factor {
  id                    String             @id @default(uuid()) @db.Uuid
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  name                  String
  description           String?
  categoryId            String             @db.Uuid
  sourceId              String             @db.Uuid
  currentValue          Float
  unit                  String
  region                String?
  notes                 String?
  isActive              Boolean            @default(true)
  effectiveFrom         DateTime           @default(now())
  effectiveTo           DateTime?
  createdBy             String             @db.Uuid
  approvedBy            String?            @db.Uuid
  approvalNotes         String?
  calculatorConstantKey String?
  changeRequests        ChangeRequest[]
  category              FactorCategory     @relation(fields: [categoryId], references: [id])
  source                FactorSource       @relation(fields: [sourceId], references: [id])
  dependents            FactorDependency[] @relation("FactorDependents")
  dependencies          FactorDependency[] @relation("FactorDependsOn")
  versions              FactorVersion[]

  @@unique([name, categoryId])
}

model FactorVersion {
  id            String                      @id @default(uuid()) @db.Uuid
  createdAt     DateTime                    @default(now())
  factorId      String                      @db.Uuid
  value         Float
  unit          String
  notes         String?
  changedBy     String                      @db.Uuid
  changeReason  String
  sourceVersion String?
  status        String                      @default("pending")
  approvedBy    String?                     @db.Uuid
  approvedAt    DateTime?
  approvalNotes String?
  factor        Factor                      @relation(fields: [factorId], references: [id])
  snapshotLinks MethodologySnapshotFactor[]
}

model FactorDependency {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now())
  factorId        String   @db.Uuid
  dependsOnId     String   @db.Uuid
  calculationPath String?
  strength        Float    @default(1.0)
  dependsOn       Factor   @relation("FactorDependents", fields: [dependsOnId], references: [id])
  factor          Factor   @relation("FactorDependsOn", fields: [factorId], references: [id])

  @@unique([factorId, dependsOnId])
}

model ChangeRequest {
  id               String    @id @default(uuid()) @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  type             String
  factorId         String?   @db.Uuid
  factorName       String
  proposedValue    Float?
  proposedUnit     String?
  proposedSource   String?
  proposedNotes    String?
  proposedCategory String?
  requestedBy      String    @db.Uuid
  reason           String
  priority         String    @default("medium")
  status           String    @default("pending")
  reviewedBy       String?   @db.Uuid
  reviewedAt       DateTime?
  reviewNotes      String?
  implementedBy    String?   @db.Uuid
  implementedAt    DateTime?
  factor           Factor?   @relation(fields: [factorId], references: [id])
}

model ImportSession {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  fileName     String
  dataType     String   @default("unknown")
  confidence   Float    @default(0)
  totalRows    Int      @default(0)
  importedRows Int      @default(0)
  skippedRows  Int      @default(0)
  status       String   @default("classifying")
  mappings     Json?
  errors       Json?
}

model RspApiKey {
  id           String              @id @default(uuid()) @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  orgId        String              @db.Uuid
  label        String
  keyHash      String              @unique
  keyPrefix    String
  isActive     Boolean             @default(true)
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  isSimulated  Boolean             @default(false)
  org          Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  periods      UsageTimePeriod[]
  activityLogs RspApiActivityLog[]
}

model UsageTimePeriod {
  id                String               @id @default(uuid()) @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  orgId             String               @db.Uuid
  accountId         String?              @db.Uuid
  clientExternalId  String
  dateMin           DateTime             @db.Date
  dateMax           DateTime             @db.Date
  submittedByKeyId  String?              @db.Uuid
  status            String               @default("active")
  supersededById    String?              @db.Uuid
  rawPayload        Json?
  co2AvoidedKg      Float                @default(0)
  waterSavedGallons Float                @default(0)
  wasteDivertedLbs  Float                @default(0)
  org               Org                  @relation(fields: [orgId], references: [id])
  account           Account?             @relation(fields: [accountId], references: [id])
  submittedByKey    RspApiKey?           @relation(fields: [submittedByKeyId], references: [id])
  products          UsagePeriodProduct[]
  supersededBy      UsageTimePeriod?     @relation("PeriodSupersedes", fields: [supersededById], references: [id])
  supersedes        UsageTimePeriod[]    @relation("PeriodSupersedes")
}

model UsagePeriodProduct {
  id                 String          @id @default(uuid()) @db.Uuid
  periodId           String          @db.Uuid
  reusableType       String
  inWarehouseEvents  Int
  outWarehouseEvents Int
  co2AvoidedKg       Float           @default(0)
  waterSavedGallons  Float           @default(0)
  wasteDivertedLbs   Float           @default(0)
  period             UsageTimePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model AdminInsight {
  id          String   @id @default(uuid()) @db.Uuid
  generatedAt DateTime @default(now())
  content     Json
  modelUsed   String   @default("claude-haiku-4-5-20251001")
}

model RspApiActivityLog {
  id              String     @id @default(uuid()) @db.Uuid
  createdAt       DateTime   @default(now())
  apiKeyId        String?    @db.Uuid
  orgId           String?    @db.Uuid
  endpoint        String // e.g. "POST /api/rsp/usage"
  httpStatus      Int
  outcome         String // success | auth_failed | validation_failed | server_error | dedup_conflict
  errorMessage    String?
  errorCode       String?
  latencyMs       Int?
  requestSummary  Json? // truncated/summarized request body
  responseSummary Json? // truncated response
  clientIp        String?
  apiKey          RspApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@index([orgId, createdAt])
  @@index([outcome, createdAt])
}

// ─── Governance / Methodology Snapshot layer ─────────────────────────────────

model MethodologySnapshot {
  id             String                      @id @default(uuid()) @db.Uuid
  createdAt      DateTime                    @default(now())
  createdBy      String                      @db.Uuid
  name           String
  notes          String?
  status         String                      @default("draft") // draft | published | deprecated
  publishedAt    DateTime?
  factorVersions MethodologySnapshotFactor[]
  computeRuns    ComputeRun[]
  testRuns       TestRun[]
}

model MethodologySnapshotFactor {
  id              String              @id @default(uuid()) @db.Uuid
  snapshotId      String              @db.Uuid
  factorVersionId String              @db.Uuid
  snapshot        MethodologySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  factorVersion   FactorVersion       @relation(fields: [factorVersionId], references: [id])

  @@unique([snapshotId, factorVersionId])
}

model ComputeRun {
  id                    String               @id @default(uuid()) @db.Uuid
  createdAt             DateTime             @default(now())
  runType               String // 'projection' | 'scenario' | 'test' | 'actuals_ingest' | 'backfill'
  status                String               @default("running") // running | success | failed
  orgId                 String?              @db.Uuid
  projectId             String?              @db.Uuid
  methodologySnapshotId String?              @db.Uuid
  startedAt             DateTime             @default(now())
  finishedAt            DateTime?
  errorText             String?
  metadataJson          Json?
  org                   Org?                 @relation(fields: [orgId], references: [id])
  project               Project?             @relation(fields: [projectId], references: [id])
  snapshot              MethodologySnapshot? @relation(fields: [methodologySnapshotId], references: [id])
  results               MetricResult[]
  milestones            ProjectMilestone[]
}

model MetricResult {
  id                    String     @id @default(uuid()) @db.Uuid
  computedAt            DateTime   @default(now())
  runId                 String     @db.Uuid
  orgId                 String?    @db.Uuid
  projectId             String?    @db.Uuid
  metricKey             String // e.g. 'co2_avoided_mtco2e', 'annual_cost_savings_usd'
  valueNumeric          Float?
  valueJson             Json?
  units                 String
  methodologySnapshotId String?    @db.Uuid
  factorVersionIdsJson  Json? // array of FactorVersion IDs used in this computation
  run                   ComputeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────

model DataHealthIssue {
  id                   String    @id @default(uuid()) @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  issueType            String
  severity             String
  entity               String
  entityId             String    @db.Uuid
  details              Json?
  status               String    @default("open")
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  note                 String?

  @@unique([issueType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────

model DataProductDefinition {
  id                    String   @id @default(uuid()) @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  name                  String
  slug                  String   @unique
  description           String?
  productType           String   @default("calculator") // calculator | dashboard | scenario | report
  audience              String   @default("internal") // internal | client | public
  status                String   @default("draft") // draft | review | published | archived
  projectType           String? // default | event | eugene | null (any)
  inputSchemaJson       Json?
  outputSchemaJson      Json?
  flowDefinitionJson    Json? // { nodes, edges, viewport }
  executionCode         String? // JS function body: (inputs) => outputs, generated by AI Designer
  methodologyDocumentId String?  @db.Uuid
  version               Int      @default(1)
  publishedVersion      Int?
  isPublic              Boolean  @default(false)
  createdByUserId       String
  updatedByUserId       String?
}

enum ProjectCategory {
  default
  event
  eugene
}

enum ProjectDataType {
  projection
  actual
}

model FeatureRequest {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  status          String        @default("open") // open | planned | in_progress | shipped | rejected
  createdAt       DateTime      @default(now())
  createdByUserId String?
  votes           FeatureVote[]

  @@index([status, createdAt])
}

model FeatureVote {
  id               String         @id @default(uuid()) @db.Uuid
  createdAt        DateTime       @default(now())
  userId           String
  featureRequestId String         @db.Uuid
  feature          FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)

  @@unique([featureRequestId, userId])
  @@index([userId])
}

enum Role {
  ORG_ADMIN
  ACCOUNT_ADMIN
  MEMBER
}

enum JoinRequestStatus {
  pending
  approved
  declined
}

model EmailEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventKey      String   @unique
  displayName   String
  description   String?
  enabled       Boolean  @default(true)
  subjectLine   String
  htmlContent   String
  textContent   String?
  variables     String[]
  recipientHint String
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

model JoinRequest {
  id          String            @id @default(uuid()) @db.Uuid
  email       String
  name        String
  message     String?
  orgId       String            @db.Uuid
  status      JoinRequestStatus @default(pending)
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  decidedBy   User?             @relation(fields: [decidedById], references: [id])

  @@unique([email, orgId])
  @@index([orgId, status])
}
